# Netlify custom headers: https://docs.netlify.com/routing/headers/

# Fingerprinted build assets (main.[hash].js / [hash].css / media).
# The filename changes on every build, so these can be cached forever.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must always be revalidated so a new deploy is picked up
# immediately and mobile browsers never boot from a stale HTML shell.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Checkout and registration flow must never be indexed. These routes are not
# prerendered, so a crawler that doesn't run JS is served the SPA fallback and
# never sees the <meta name="robots"> the pages render — the header is what
# actually enforces it. The meta tag stays as the JS-rendered equivalent.
/checkout
  X-Robots-Tag: noindex, nofollow
/payment
  X-Robots-Tag: noindex, nofollow
/paymentform
  X-Robots-Tag: noindex, nofollow
/paymentform/*
  X-Robots-Tag: noindex, nofollow
